# =============================================================================
# PasarguardBot — DEV environment (local development & ForApp testing)
# Copy to `.env.dev` and run:  docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
# NEVER use these credentials or this file anywhere near production.
# =============================================================================

# --- Telegram (dummy values are fine: the bot won't connect, FastAPI still serves) ---
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627
BOT_TOKEN=1111111111:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ADMIN_ID=100000001

# --- Dev database (MariaDB service in docker-compose.dev.yml) ---
MARIADB_ROOT_PASSWORD=devrootpass
MARIADB_DATABASE=pasarguardbot_dev
MARIADB_USER=pasarguardbot
MARIADB_PASSWORD=devdbpass
SQLALCHEMY_DATABASE_URL=mysql+asyncmy://pasarguardbot:devdbpass@mariadb:3306/pasarguardbot_dev

# --- Dev redis ---
REDIS_URL=redis://redis:6379

# --- FastAPI (dev port; host-mapped in docker-compose.dev.yml) ---
FASTAPI_PORT=6170

# --- Seed guard (scripts/seed_dev.py refuses to run without this =1) ---
PASARGUARDBOT_DEV_SEED=1

# --- ForApp webhook test key (put the same in the Android app's X-API-Key header) ---
FORAPP_API_KEYS=forapp_dev_key_change_me
